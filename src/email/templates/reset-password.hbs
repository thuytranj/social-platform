<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Reset Password</title>
  </head>
  <body
    style='margin: 0; padding: 0; background: #f4f7fb; font-family: Helvetica, Arial, sans-serif;'
  >
    <table
      role='presentation'
      cellpadding='0'
      cellspacing='0'
      width='100%'
      style='padding: 24px 12px;'
    >
      <tr>
        <td align='center'>
          <table
            role='presentation'
            cellpadding='0'
            cellspacing='0'
            width='100%'
            style='max-width: 560px; background: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid #e8edf4;'
          >
            <tr>
              <td style='background: #0b172a; color: #ffffff; padding: 24px;'>
                <h1 style='margin: 0; font-size: 22px; line-height: 1.3;'>Reset
                  your password</h1>
              </td>
            </tr>
            <tr>
              <td style='padding: 24px;'>
                <p
                  style='margin: 0 0 14px; color: #1f2937; font-size: 15px; line-height: 1.6;'
                >
                  We received a request to reset your password.
                </p>

                <p style='margin: 0 0 8px; color: #6b7280; font-size: 13px;'>Use
                  this one-time code:</p>

                <div
                  style='margin: 0 0 18px; background: #eef3ff; border: 1px dashed #5b7cfa; border-radius: 10px; padding: 14px; text-align: center;'
                >
                  <span
                    style='font-size: 28px; letter-spacing: 6px; color: #0f172a; font-weight: 700;'
                  >{{otp}}</span>
                </div>

                <p
                  style='margin: 0 0 8px; color: #1f2937; font-size: 15px; line-height: 1.6;'
                >
                  Enter this code in your reset-password form to continue.
                </p>

                {{#if resetUrl}}
                  <div style='margin: 16px 0 18px;'>
                    <a
                      href='{{resetUrl}}'
                      style='display: inline-block; background: #1d4ed8; color: #ffffff; text-decoration: none; font-size: 14px; font-weight: 600; padding: 11px 16px; border-radius: 8px;'
                    >Open reset-password form</a>
                  </div>
                {{/if}}

                <p
                  style='margin: 0; color: #6b7280; font-size: 13px; line-height: 1.6;'
                >
                  If you did not request this, you can safely ignore this email.
                </p>
              </td>
            </tr>
            <tr>
              <td style='padding: 0 24px 24px;'>
                <div
                  style='border-top: 1px solid #e5e7eb; padding-top: 12px; color: #9ca3af; font-size: 12px;'
                >
                  This code expires soon for security reasons.
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>